# django secret
DJANGO_SECRET_KEY=change-me-to-a-secure-key

# Allowed hosts/origins for local frontend and Docker frontend (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# SQL Server database configuration
DB_NAME=reza
DB_USER=sa
DB_PASSWORD=your-sql-server-password
DB_HOST=localhost\SQLEXPRESS
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONNECTION_TIMEOUT=30

# Debug
DEBUG=True

# Media
MEDIA_URL=/media/
MEDIA_ROOT=./media
