# django secret
DJANGO_SECRET_KEY=change-me-to-a-secure-key

# Allowed origins for the React frontend (comma separated)
ALLOWED_ORIGINS=http://localhost:5173

# Database: set to mysql://user:pass@db:3306/dbname for docker-compose
DATABASE_URL=sqlite:///db.sqlite3

# Debug
DEBUG=True

# Media
MEDIA_URL=/media/
MEDIA_ROOT=./media
