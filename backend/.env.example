# django secret
DJANGO_SECRET_KEY=change-me-to-a-secure-key

# Allowed origins for the React frontend (comma separated)
ALLOWED_ORIGINS=http://localhost:5173

# Database: set to mysql://user:pass@db:3306/dbname for docker-compose
DATABASE_URL=mysql://reza:REPLACE_ME@db:3306/reza

# MySQL variables used by docker-compose (fill these in your local .env)
MYSQL_ROOT_PASSWORD=REPLACE_ME
MYSQL_DATABASE=reza
MYSQL_USER=reza
MYSQL_PASSWORD=REPLACE_ME

# Debug
DEBUG=True

# Media
MEDIA_URL=/media/
MEDIA_ROOT=./media
