# Copy to .env for Docker Compose if you want to override defaults.

DJANGO_SECRET_KEY=change-me-for-local-docker
DJANGO_DEBUG=True

# SQL Server container and Django both use this password.
# SQL Server requires a strong password: uppercase, lowercase, number, symbol.
DB_NAME=reza
DB_USER=sa
DB_PASSWORD=RezaFormal!2026
DB_HOST=db
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

FRONTEND_PORT=3000
BACKEND_PORT=8000
MSSQL_PORT=1433

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true
RUN_SEED_DATA=true
DB_AUTO_CREATE=true
VITE_API_BASE=/api
