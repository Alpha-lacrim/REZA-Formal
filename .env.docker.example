# Copy this file to .env, then fill both required secrets before starting Compose.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Optional local admin created by `python manage.py seed_data`.
# Set both email and password, or leave both blank to skip admin creation.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_USERNAME=admin

# SQL Server and Django must use the same password. SQL Server requires at least
# eight characters containing uppercase, lowercase, number, and symbol.
DB_NAME=reza
DB_USER=sa
DB_PASSWORD=
DB_HOST=db
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONNECTION_TIMEOUT=30
DB_WAIT_TIMEOUT=180

FRONTEND_PORT=3000
BACKEND_PORT=8000
MSSQL_PORT=1433

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Optional Google Identity Services web client ID (blank disables backend login).
GOOGLE_OAUTH_CLIENT_ID=

# Local HTTP cookie/security defaults. Harden these only after HTTPS and trusted
# proxy forwarding are configured and verified.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SAMESITE=Strict
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False

RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true
RUN_SEED_DATA=true
DB_AUTO_CREATE=true
VITE_API_BASE=/api
